ENVIRONMENT=dev
LOG_LEVEL=INFO

BREEZE_API_KEY=
BREEZE_API_SECRET=
BREEZE_SESSION_TOKEN=
BREEZE_MIN_REQUEST_INTERVAL_SECONDS=0.65
BREEZE_MAX_REQUESTS_PER_RUN=4500
BREEZE_REQUEST_RETRY_ATTEMPTS=3
BREEZE_REQUEST_RETRY_BASE_DELAY_SECONDS=1.0

UPSTOX_ACCESS_TOKEN=
UPSTOX_BASE_URL=https://api.upstox.com
UPSTOX_MIN_REQUEST_INTERVAL_SECONDS=1.0
UPSTOX_MAX_REQUESTS_PER_RUN=1800
UPSTOX_REQUEST_RETRY_ATTEMPTS=3
UPSTOX_REQUEST_RETRY_BASE_DELAY_SECONDS=1.0

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=
R2_BUCKET_NAME=market-data
R2_DATA_CATALOG_NAME=cloudflare_r2
R2_DATA_CATALOG_URI=
R2_DATA_CATALOG_WAREHOUSE=
ICEBERG_CASH_NAMESPACE=cash
ICEBERG_CASH_TABLE=ohlcv_by_symbol
ICEBERG_CASH_SECOND_NAMESPACE=cash
ICEBERG_CASH_SECOND_TABLE=ohlcv_1s_by_symbol
ICEBERG_OPTIONS_NAMESPACE=options
ICEBERG_OPTIONS_TABLE=ohlcv
ICEBERG_FUTURE_NAMESPACE=future
ICEBERG_FUTURE_TABLE=ohlcv
ICEBERG_TABLE_FORMAT_VERSION=2
ICEBERG_PARQUET_COMPRESSION=zstd

DATA_DIR=data
DEFAULT_INTERVAL=1minute
CASH_EXCHANGE_CODE=NSE
CASH_PRODUCT_TYPE=cash
CASH_HISTORY_CHUNK_DAYS=1
CASH_HISTORY_SESSIONS_PER_REQUEST=2
CASH_HISTORY_USE_SESSION_CALENDAR=true
CASH_SYMBOL_WORKERS=1
CASH_DOWNLOAD_WORKERS=1
CASH_UPLOAD_WORKERS=1
CASH_UPLOAD_BATCH_SIZE=25
CASH_UPLOAD_RETRY_ATTEMPTS=3
CASH_UPLOAD_RETRY_BASE_DELAY_SECONDS=1.0
CASH_SYNC_MAX_DAYS_PER_RUN=30
CASH_SYNC_FROM_DATE=
CASH_SYNC_TO_DATE=

CASH_SECOND_INTERVAL=1second
CASH_SECOND_HISTORY_WINDOW_SECONDS=900
CASH_SECOND_MAX_CANDLES_PER_REQUEST=1000
CASH_SECOND_MARKET_OPEN_TIME=09:15:00
CASH_SECOND_MARKET_CLOSE_TIME=15:30:00
CASH_SECOND_SKIP_WEEKENDS=true
CASH_SECOND_USE_MINUTE_EMPTY_DAYS=true
CASH_SECOND_SYMBOL_WORKERS=1
CASH_SECOND_DOWNLOAD_WORKERS=1
CASH_SECOND_UPLOAD_WORKERS=1
CASH_SECOND_UPLOAD_BATCH_SIZE=10
CASH_SECOND_SYNC_MAX_DAYS_PER_RUN=7
CASH_SECOND_SYNC_FROM_DATE=2026-01-01
CASH_SECOND_SYNC_TO_DATE=
